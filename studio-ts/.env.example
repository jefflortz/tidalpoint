# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
CONTENT_PROCESSOR_MODEL=gpt-5.4-mini
# Either name is supported. SANITY_API_TOKEN matches the existing deployment.
SANITY_API_TOKEN=
# Frontend URL loaded by Sanity's Presentation preview. Set this per Studio environment.
SANITY_STUDIO_PREVIEW_URL=http://localhost:3000
CONTENT_INTAKE_SECRET=
SANITY_PUBLISH_WEBHOOK_SECRET=
FEATURED_IMAGE_MODEL=gpt-image-2
FEATURED_IMAGE_SIZE=2048x1152
FEATURED_IMAGE_QUALITY=high
SOURCE_IMAGE_HOSTS=images.pexels.com
